# Bitcoin Core RPC (required)
BTC_RPC_HOST=127.0.0.1:8332
BTC_RPC_USER=
BTC_RPC_PASS=

# Citrea L2 RPC (optional — defaults shown)
# CITREA_RPC_URL=https://rpc.mainnet.citrea.xyz
# BATCH_EXPLORER_URL=https://batch-explorer.mainnet.citrea.xyz

# Lightning payments via Spark (optional — omit to serve all data freely)
# SPARK_MNEMONIC=
# SPARK_NETWORK=MAINNET

# Dashboard (optional)
# PORT=3000
# CORS_ORIGIN=*
